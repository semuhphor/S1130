{
    "dotnet.defaultSolution": "S1130.sln",
    "dotnet.enablePackageRestore": true,
    "dotnet.server.useOmnisharp": false,
    "dotnet.backgroundAnalysis.analyzerDiagnosticsScope": "openFiles",
    "dotnet.backgroundAnalysis.compilerDiagnosticsScope": "openFiles",

    // Testing sidebar (C# Dev Kit): discover, run and debug xUnit tests in both test projects.
    "dotnet.testWindow.useTestingPlatformProtocol": false,
    "dotnet.testWindow.disableBuildOnRefresh": false,
    "dotnet.unitTestDebuggingOptions": {
        "justMyCode": true,
        "suppressJITOptimizations": true,
        "console": "internalConsole"
    },
    "testing.automaticallyOpenPeekView": "failureInVisibleDocument",
    "testing.defaultGutterClickAction": "run",
    "testing.openTesting": "openOnTestFailure",

    "files.exclude": {
        "**/bin": true,
        "**/obj": true
    },
    "testing.automaticallyOpenTestResults": "openOnTestFailure"
}